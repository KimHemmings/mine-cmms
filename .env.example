# Copy to .env.local for development. In Vercel, set these under
# Project Settings > Environment Variables for Production and Preview.

# Supabase (Project Settings > API Keys). The publishable key is safe in the
# browser only because Row Level Security is enforced on every table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Azure OpenAI (server-only, never prefix with NEXT_PUBLIC_)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21
